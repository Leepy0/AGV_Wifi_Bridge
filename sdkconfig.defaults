CONFIG_IDF_TARGET="esp32s3"

# 플래시/파티션 (S3 보드는 대부분 4MB 이상) — OTA 두 슬롯 (partitions.csv)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OTA 롤백: 새 펌웨어가 서버 통신을 확인하기 전에 재부팅되면 이전 슬롯으로 복귀
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# 현장 서버는 사내망 HTTP (인증서 관리 부담 없음)
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# 1ms tick — 프레임 간격(ms 단위) 제어용
CONFIG_FREERTOS_HZ=1000

# 로밍 대비 802.11k/v/r
CONFIG_ESP_WIFI_11KV_SUPPORT=y
CONFIG_ESP_WIFI_11R_SUPPORT=y

# 무인 운용: 태스크 워치독 발생 시 재부팅
CONFIG_ESP_TASK_WDT_PANIC=y

# 플래시 쓰기(NVS save, OTA) 중에도 UART 수신 유지
CONFIG_UART_ISR_IN_IRAM=y

# DHCP 재연결 단축: 제안 IP ARP 확인 생략 (현장은 고정 IP 권장)
CONFIG_LWIP_DHCP_DOES_NOT_CHECK_OFFERED_IP=y

# 설정 AP 웹 페이지: 휴대폰 브라우저 요청 헤더가 512B 를 넘는 경우 대비 (v5.x 기본값 보완)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# 무선 설정(BLE): NimBLE 주변기기(peripheral) 역할만, 연결 1개, 페어링 미사용(앱 수준 비밀번호)
# BT 컨트롤러는 설정 모드 동안만 초기화 — 평상시 Wi-Fi 는 무선부를 단독 사용
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
